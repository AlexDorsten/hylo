COMPOSE_PROJECT_NAME=hylo
HYLO_DOMAIN=hylo.example.org
HYLO_IMAGE=hylo-local:development
# Record immutable digests for a deployment after validating these versions.
NODE_IMAGE=node:24-bookworm-slim
POSTGIS_IMAGE=postgis/postgis:17-3.5
REDIS_IMAGE=redis:7.2-alpine
API_PORT=3001
WEB_PORT=9001

# Generate each independently with: openssl rand -hex 32
# Use hex for APP_DB_PASSWORD because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
COOKIE_SECRET=
JWT_SECRET=

# Public browser credentials only; changing them requires rebuilding the image.
VITE_FILESTACK_API_KEY=
VITE_MAPBOX_TOKEN=
VITE_STRIPE_CLIENT_ID=
