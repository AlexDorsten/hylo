# Private runtime settings. Copy to backend.env; never commit the filled file.
# Bootstrap/migrations do not require provider accounts.
# See docs/self-hosting/README.md and issues #3-6 before enabling the application.
# Embedded Hylo token issuer; independent of external login below.
OIDC_KEYS=
# Disable after the initial operator account is complete. Existing logins remain available.
HYLO_REGISTRATION_ENABLED=true
# Optional external providers: see docs/self-hosting/OIDC.md. Never a VITE_ value.
# ZITADEL web-client recipe: docs/self-hosting/ZITADEL.md.
HYLO_OIDC_PROVIDERS='[]'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_API_KEY=
LINKEDIN_API_SECRET=
# Community mode does not require a Stripe account or placeholder keys.
HYLO_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Four account templates are available through SMTP; see docs/self-hosting/SMTP.md.
EMAIL_PROVIDER=smtp
EMAIL_SENDER=
EMAIL_SENDER_NAME=Hylo
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
# Alternatively mount a secret into api, worker and maintenance:
SMTP_PASSWORD_FILE=
SENDWITHUS_KEY=
EMAIL_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_TESTING_ENABLED=false
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_CONTENT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOADER_PATH_PREFIX=evo-uploads
# Server geocoding only; browser maps need VITE_MAPBOX_TOKEN at image build time.
MAPBOX_TOKEN=
# Comma-separated, verified local user IDs; no automatic email-domain grants.
HYLO_ADMINS=
HYLO_TESTER_IDS=
SENTRY_DSN=
