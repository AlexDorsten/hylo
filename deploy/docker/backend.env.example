LINKEDIN_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_SENDER=
SENDWITHUS_KEY=
EMAIL_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_TESTING_ENABLED=false
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_CONTENT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOADER_PATH_PREFIX=evo-uploads
MAPBOX_TOKEN=
HYLO_ADMINS=
SENTRY_DSN=
