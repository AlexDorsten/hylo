# Private runtime settings. Copy to backend.env; never commit the filled file.
# Bootstrap/migrations do not require provider accounts. Application startup does.
# See docs/self-hosting/README.md and issues #3-6 before enabling the application.
# Embedded Hylo token issuer; independent of external login below.
OIDC_KEYS=
# Optional external providers: see docs/self-hosting/OIDC.md. Never a VITE_ value.
HYLO_OIDC_PROVIDERS='[]'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_API_KEY=
LINKEDIN_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_SENDER=
SENDWITHUS_KEY=
EMAIL_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_TESTING_ENABLED=false
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_CONTENT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOADER_PATH_PREFIX=evo-uploads
MAPBOX_TOKEN=
# Comma-separated, verified local user IDs; no automatic email-domain grants.
HYLO_ADMINS=
HYLO_TESTER_IDS=
SENTRY_DSN=
